  "cases": [
    {
      "case_id": "search-exact-product",
      "category": "search",
      "user_request": "Find Alpha Phone",
      "analysis": {"request_type": "search", "normalized_query": "alpha phone"},
      "search_batches": [["fixture:alpha"]],
      "draft": {"facts": [{"product_id": "fixture:alpha", "field": "price_inr", "value": 19999, "citation": {"product_id": "fixture:alpha", "source_url": "https://example.test/alpha"}}]},
      "expected_status": "answered",
      "expected_tools": ["catalogue_search", "product_details", "evidence_verification"],
      "expected_path": ["analyze_request", "catalogue_search", "product_details", "generate_search_answer", "verify_evidence"]
    },
    {
      "case_id": "search-strict-budget",
      "category": "constraints",
      "user_request": "Find Alpha phones under 20000 with 8 GB RAM",
      "analysis": {"request_type": "search", "normalized_query": "alpha phone", "constraints": {"max_price_inr": 20000, "min_ram_gb": 8, "included_brands": ["Alpha"]}},
      "search_batches": [["fixture:alpha"]],
      "draft": {"facts": [{"product_id": "fixture:alpha", "field": "ram_gb", "value": 8.0, "citation": {"product_id": "fixture:alpha", "source_url": "https://example.test/alpha"}}]},
      "expected_status": "answered",
      "expected_tools": ["catalogue_search", "product_details", "evidence_verification"],
      "expected_path": ["analyze_request", "catalogue_search", "product_details", "generate_search_answer", "verify_evidence"]
    },
    {
      "case_id": "search-reformulation-success",
      "category": "reformulation",
      "user_request": "Find the alpha handset",
      "analysis": {"request_type": "search", "normalized_query": "unknown alpha handset", "constraints": {"max_price_inr": 20000, "included_brands": ["Alpha"]}},
      "search_batches": [[], ["fixture:alpha"]],
      "reformulations": ["alpha phone"],
      "draft": {"facts": [{"product_id": "fixture:alpha", "field": "brand", "value": "Alpha", "citation": {"product_id": "fixture:alpha", "source_url": "https://example.test/alpha"}}]},
      "expected_status": "answered",
      "expected_tools": ["catalogue_search", "catalogue_search", "product_details", "evidence_verification"],
      "expected_path": ["analyze_request", "catalogue_search", "reformulate_query", "catalogue_search", "product_details", "generate_search_answer", "verify_evidence"],
      "expected_retry_count": 1
    },
    {
      "case_id": "search-unavailable-product",
      "category": "unavailable_product",
      "user_request": "Find a phone that is not in this catalogue",
      "analysis": {"request_type": "search", "normalized_query": "missing catalogue phone"},
