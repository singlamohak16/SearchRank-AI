      "reformulations": ["missing phone"],
      "expected_status": "no_results",
      "expected_tools": ["catalogue_search", "catalogue_search"],
      "expected_path": ["analyze_request", "catalogue_search", "reformulate_query", "catalogue_search", "no_results"],
      "expected_retry_count": 1
    },
    {
      "case_id": "clarify-best-without-criterion",
