# Application
SEARCHRANK_ENVIRONMENT=development
SEARCHRANK_LOG_LEVEL=INFO

# Storage (used in a later phase)
SEARCHRANK_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/searchrank

# LLM provider (the mock provider will support tests without an API key)
SEARCHRANK_LLM_PROVIDER=mock
SEARCHRANK_LLM_MODEL=
SEARCHRANK_LLM_API_KEY=

