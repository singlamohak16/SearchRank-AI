# Application
SEARCHRANK_ENVIRONMENT=development
SEARCHRANK_LOG_LEVEL=INFO

# Local catalogue and retrieval artefacts generated by Phases 1-3
SEARCHRANK_CATALOGUE_PATH=data/processed/suresh_91mobiles_2008_2026/catalogue.csv
SEARCHRANK_BM25_INDEX_PATH=artifacts/bm25/phase2-index.json
SEARCHRANK_SEMANTIC_INDEX_PATH=artifacts/semantic/phase3-index.npz
SEARCHRANK_EMBEDDING_DEVICE=cpu
# Keep API startup offline-first after the Phase 3 model has been cached
SEARCHRANK_EMBEDDING_LOCAL_ONLY=1

# PostgreSQL + pgvector storage (replace locally; never commit real credentials)
SEARCHRANK_DATABASE_URL=postgresql://username:password@localhost:5432/searchrank

# Optional integration-test database; use a disposable database only
SEARCHRANK_TEST_DATABASE_URL=

# LLM provider (the mock provider will support tests without an API key)
SEARCHRANK_LLM_PROVIDER=mock
SEARCHRANK_LLM_MODEL=
SEARCHRANK_LLM_API_KEY=

# Optional paid-provider integration test; runs only when explicitly set to 1
SEARCHRANK_RUN_LLM_INTEGRATION=0

# Streamlit connects to the FastAPI process over HTTP
SEARCHRANK_API_URL=http://127.0.0.1:8000
